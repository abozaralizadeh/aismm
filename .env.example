# =============================================================================
# AI Social Media Manager (AISMM) — environment configuration
# Copy to `.env` and fill in. NEVER commit `.env` (it is git-ignored).
# =============================================================================

# --- LLM provider selection -------------------------------------------------
# "azure" = talk directly to Azure OpenAI (api-key).
# "apim"  = talk through an Azure API Management gateway / load balancer.
LLM_PROVIDER=azure

# The chat model / deployment name used by the manager agent (both providers).
AZURE_OPENAI_MODEL=gpt-4o
# Reasoning models (o1/o3/o4, gpt-5.x) REJECT `temperature` with a 400 rather
# than ignoring it, so AISMM omits it for them. It works that out from the model
# name — but on Azure that is the DEPLOYMENT name you chose, so set this
# explicitly if yours does not reveal the family (0 = never send temperature).
# LLM_SUPPORTS_TEMPERATURE=

# --- Azure OpenAI (direct) — used when LLM_PROVIDER=azure --------------------
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com
AZURE_OPENAI_API_VERSION=2025-04-01-preview

# --- APIM load balancer — used when LLM_PROVIDER=apim -----------------------
# Point base_url at the APIM route that fronts your Azure OpenAI backend(s),
# WITHOUT a trailing /openai — the client appends it, calling
#   <APIM_BASE_URL>/openai/responses?api-version=...
# APIM_KEY_HEADER is the header your APIM policy expects the subscription key in
# (commonly "api-key" or "Ocp-Apim-Subscription-Key").
APIM_BASE_URL=https://<your-apim>.azure-api.net/<openai-path>
APIM_SUBSCRIPTION_KEY=
APIM_KEY_HEADER=api-key
APIM_API_VERSION=2025-04-01-preview

# --- Image generation (gpt-image-1 / DALL·E) — optional ---------------------
# A separate Azure resource may host the image deployment (mirrors Azure's
# usual key/endpoint split). Leave blank to disable the image tool.
AZURE_OPENAI_API_KEY_DALLE=
AZURE_OPENAI_ENDPOINT_DALLE=https://<your-dalle-resource>.openai.azure.com
AZURE_OPENAI_MODEL_DALLE=gpt-image-1

# --- Sora 2 video generation — optional -------------------------------------
# Comma-separated, index-aligned pools spread load across resources while each
# job (create/poll/download) stays pinned to the resource that served it.
# Point these DIRECTLY at each resource, NOT at a round-robin gateway.
# The n-th key belongs to the n-th endpoint; a single key/model is reused for
# every endpoint (only correct when the resources really share it).
AZURE_OPENAI_ENDPOINT_SORA=https://<sora-a>.openai.azure.com,https://<sora-b>.openai.azure.com
AZURE_OPENAI_API_KEY_SORA=<key-for-a>,<key-for-b>
AZURE_OPENAI_MODEL_SORA=sora-2
AZURE_OPENAI_API_VERSION_SORA=preview
# How many resources one clip may try before giving up (failover rotates to a
# resource that hasn't failed this clip). 0 = auto: pool size, capped at 3.
SORA_MAX_ATTEMPTS=0

# --- Token encryption -------------------------------------------------------
# Fernet key used to encrypt OAuth tokens at rest. If empty, AISMM generates
# one on first run and stores it in ./tokens.key (git-ignored). To pin it,
# generate with:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AISMM_TOKEN_KEY=

# --- Logging ----------------------------------------------------------------
# DEBUG | INFO | WARNING | ERROR. INFO narrates each run (start/finish, tools,
# media conversion, publish decisions, platform API steps). DEBUG additionally
# turns on httpx request lines — use it when a platform API is misbehaving.
LOG_LEVEL=INFO

# --- Publish safety ---------------------------------------------------------
# Refuse to publish a caption written in the agent's own failure voice ("I was
# unable to retrieve…", "as an AI language model", tool names). A blocked run
# should call report_failure, not post about the problem. Set to 0 only if you
# genuinely need to publish such text.
PUBLISH_CONTENT_GUARD=1

# The same media is never published twice. When the guard fires it first checks
# whether that earlier post is STILL on the account, so anything you delete by
# hand can be posted again. This setting decides what happens when that check
# cannot complete (rate limited, network trouble):
#   0 (default) publish anyway — for sequential content (a comic posted panel by
#     panel) a wrongly skipped item breaks the order and the gap is permanent,
#     while a duplicate is two taps to delete.
#   1 refuse — for accounts where an accidental duplicate costs more than a gap.
# A CONFIRMED duplicate is always refused, whichever way this is set.
PUBLISH_DUPLICATE_GUARD_STRICT=0

# --- Instagram OAuth scopes -------------------------------------------------
# Overrides the requested scopes entirely (commas or spaces). The value below is
# also the built-in default, so leaving it blank asks for exactly this set.
#
# ⚠️ Meta rejects the ENTIRE login dialog if your app cannot request even one of
# these — "Invalid Scopes: instagram_manage_insights" — and that blocks
# connecting at all, including publishing, which does not need insights.
# `instagram_manage_insights` needs App Review. If a connect is refused, delete
# it from the line below and reconnect; add it back once review grants it.
# Minimum that can still publish:
#   instagram_basic instagram_content_publish pages_show_list pages_read_engagement
INSTAGRAM_SCOPES="instagram_basic instagram_content_publish pages_show_list pages_read_engagement business_management instagram_manage_comments instagram_manage_insights"

# --- AI-content disclosure --------------------------------------------------
# Labels every post as AI-generated. ON by default: the EU AI Act's Article 50
# transparency obligations apply from 2 Aug 2026, and Instagram/TikTok/YouTube/X
# each require AI content to be disclosed. The label is appended to the caption
# (trimming the caption, never the label, to fit the platform's limit) and the
# platform's own AI flag is set where its API has one (TikTok is_aigc, YouTube
# containsSyntheticMedia). Set to 0 only if you have a reason not to disclose.
AI_DISCLOSURE_ENABLED=1
# The platform's own AI label is always set when disclosure is on. Set this to 1
# to ALSO append the label text to the caption.
AI_DISCLOSURE_CAPTION=0
AI_DISCLOSURE_TEXT=🤖 AI-generated
AI_DISCLOSURE_SEPARATOR=\n\n

# --- Storage backend: local SQLite, or Azure Table + Blob -------------------
# "auto" (default) = use Azure as soon as a connection string is set below,
# otherwise local SQLite. Force with "local" or "azure".
STORE_BACKEND=auto
# One storage account serves both, exactly like the SandBox projects: a single
# TABLE holds every entity (PartitionKey = type, RowKey = id) and a BLOB
# container holds generated media. SandBox shares its account under the
# lowercase name `connection_string`, which is also accepted — so a SandBox .env
# drops straight in.
# Portal: Storage account -> Security + networking -> Access keys -> Connection string
AZURE_STORAGE_CONNECTION_STRING=
AISMM_TABLE_NAME=aismm
AISMM_BLOB_NAME=aismm-media
# NOTE: for Instagram, set the container's access level to "Blob (anonymous read
# access for blobs only)" — IG fetches media from a PUBLIC url. With blob
# storage on, asset URLs become blob URLs, so the dashboard no longer has to be
# publicly reachable for publishing to work.
# With blob storage on, data/assets is a CACHE: a daily job deletes local files
# older than this, but ONLY once the blob copy is confirmed to exist. Without
# blob storage nothing is ever pruned (the local file is the only copy). 0 = off.
ASSET_RETENTION_DAYS=14

# --- Paths / runtime --------------------------------------------------------
# Used by the local backend (SQLite db) and always as the local media cache.
AISMM_DATA_DIR=./data
ENV=dev
# Set to 0 to serve the dashboard WITHOUT the scheduler when running under a
# WSGI server (aismm.wsgi:application). Ignored by `aismm dashboard`/`scheduler`.
AISMM_ENABLE_SCHEDULER=1
# An instruction's carry-over memory is summarized once it grows past this many
# characters, so a long-running instruction's prompt stays small.
MEMORY_MAX_CHARS=6000

# --- Dashboard --------------------------------------------------------------
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8787
# Public base URL the dashboard is reachable at. Required for OAuth redirect
# URIs and for Instagram (which fetches media from a PUBLIC url). For local
# testing use an https tunnel (e.g. ngrok) and put its URL here.
DASHBOARD_BASE_URL=http://127.0.0.1:8787
# Optional URL path where nginx/Caddy exposes AISMM (for example /aismm).
# This is automatically added to dashboard links, forms, assets, and OAuth URLs.
REVERSE_PROXY_PREFIX=
# Signs the session cookie that keeps you logged in. Set a long random value in
# production (a weak one lets an attacker forge a signed-in session):
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
FLASK_SECRET_KEY=change-me

# Public legal pages served at <BASE_URL><PREFIX>/legal/terms and /legal/privacy.
# Some platform developer consoles require both URLs to approve an app — TikTok
# will not approve one without a Terms of Service and Privacy Policy link. These
# personalise the built-in pages; leave blank to fall back to the product name
# and the first AUTH_OWNER_EMAILS address.
LEGAL_ENTITY_NAME=
LEGAL_CONTACT_EMAIL=
LEGAL_UPDATED=

# Domain-ownership verification. TikTok (and other consoles) prove you own the
# site by fetching a file at the root, e.g. <BASE_URL><PREFIX>/tiktok<code>.txt.
# Paste ONLY the code TikTok gives you (the string after
# "tiktok-developers-site-verification="); the file and its body are derived:
#   TIKTOK_VERIFICATION_CODE=G7lhCOWWCIWrFsUeXdTwwObBFHktsVkh
TIKTOK_VERIFICATION_CODE=
# General escape hatch for any other provider's verification file — a JSON map
# of {filename: exact-body}, served as text/plain at the site root:
#   SITE_VERIFICATION_JSON={"google1234.html": "google-site-verification: ..."}
SITE_VERIFICATION_JSON=

# --- Dashboard sign-in (SSO / OpenID Connect) -------------------------------
# The dashboard has NO login of its own. Leave these blank only when it is bound
# to localhost; anything reachable from the internet must set them.
# Works with any OIDC provider — the endpoints come from the issuer's discovery
# document. Issuer examples:
#   Google      https://accounts.google.com
#   Entra ID    https://login.microsoftonline.com/<tenant-id>/v2.0
#   Okta        https://<org>.okta.com
# Register this redirect URI with the provider:
#   <DASHBOARD_BASE_URL><REVERSE_PROXY_PREFIX>/auth/callback
AUTH_OIDC_ISSUER=
AUTH_OIDC_CLIENT_ID=
AUTH_OIDC_CLIENT_SECRET=
AUTH_OIDC_SCOPES=openid,email,profile
# WHO may sign in. Authenticating is not enough — an identity must match one of
# these or it is refused. Leave both empty and EVERY login is rejected (fail
# closed), because otherwise any account at the provider would get in.
AUTH_ALLOWED_EMAILS=you@example.com
AUTH_ALLOWED_DOMAINS=
# The SITE OWNER(s): a single deployment-wide operator who sees the owner-only
# Admin page (cross-workspace usage) and manages/shares the .env deployment LLM.
# Comma-separated emails; empty = no owner (fails closed). With SSO off the local
# operator is always the owner.
AUTH_OWNER_EMAILS=
# Cosmetic: the sign-in button reads "Sign in with <name>".
AUTH_PROVIDER_NAME=SSO
AUTH_SESSION_HOURS=12
# Blank = auto (on as soon as the three AUTH_OIDC_* values are set).
# AUTH_ENABLED=0 disables the guard — only ever for local development.
AUTH_ENABLED=

# =============================================================================
# Social platform developer-app credentials — OPTIONAL FALLBACK
#
# These are now editable in the dashboard (Apps page), which also supports
# SEVERAL apps per platform and shows where to find each value. The variables
# below are used only for a platform that has no app configured there, so an
# existing deployment keeps working unchanged.
# See README.md for step-by-step "create an app + connect an account" guides.
# Each platform's redirect/callback URL is:
# <DASHBOARD_BASE_URL><REVERSE_PROXY_PREFIX>/oauth/<platform>/callback
# =============================================================================

# --- Instagram (Meta) — Instagram Graph API ---------------------------------
# Requires an Instagram Business/Creator account linked to a Facebook Page.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# --- X / Twitter — API v2 (OAuth 2.0 PKCE) ----------------------------------
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
# App-only / OAuth 1.0a keys are additionally needed for v1.1 media upload:
TWITTER_API_KEY=
TWITTER_API_SECRET=

# --- YouTube — Google Cloud OAuth (Data API v3) -----------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- TikTok — Content Posting API -------------------------------------------
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# --- LinkedIn — Posts API (member share) ------------------------------------
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# --- Facebook Pages — Meta Graph API ----------------------------------------
# Optional: falls back to the INSTAGRAM_APP_* values above, so an existing Meta
# app posts to Facebook Pages with no extra credentials.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# --- Reddit — submit API (web app) ------------------------------------------
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# --- LangSmith tracing — optional but recommended ---------------------------
# Routes the Agents SDK's own tracer into LangSmith (the SandBox/ComicBook
# pattern), giving the agent/tool/handoff span tree rather than raw LLM calls.
# Traces are sent only when LANGCHAIN_API_KEY is set; without it, tracing is
# DISABLED rather than left pointing at api.openai.com (which 401s on Azure).
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=AISMM
# Only needed for self-hosted / EU LangSmith:
# LANGCHAIN_ENDPOINT=https://eu.api.smith.langchain.com
