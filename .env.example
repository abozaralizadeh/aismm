# =============================================================================
# AI Social Media Manager (AISMM) — environment configuration
# Copy to `.env` and fill in. NEVER commit `.env` (it is git-ignored).
# =============================================================================

# --- LLM provider selection -------------------------------------------------
# "azure" = talk directly to Azure OpenAI (api-key).
# "apim"  = talk through an Azure API Management gateway / load balancer.
LLM_PROVIDER=azure

# The chat model / deployment name used by the manager agent (both providers).
AZURE_OPENAI_MODEL=gpt-4o

# --- Azure OpenAI (direct) — used when LLM_PROVIDER=azure --------------------
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com
AZURE_OPENAI_API_VERSION=2025-04-01-preview

# --- APIM load balancer — used when LLM_PROVIDER=apim -----------------------
# Point base_url at the APIM route that fronts your Azure OpenAI backend(s),
# WITHOUT a trailing /openai — the client appends it, calling
#   <APIM_BASE_URL>/openai/responses?api-version=...
# APIM_KEY_HEADER is the header your APIM policy expects the subscription key in
# (commonly "api-key" or "Ocp-Apim-Subscription-Key").
APIM_BASE_URL=https://<your-apim>.azure-api.net/<openai-path>
APIM_SUBSCRIPTION_KEY=
APIM_KEY_HEADER=api-key
APIM_API_VERSION=2025-04-01-preview

# --- Image generation (gpt-image-1 / DALL·E) — optional ---------------------
# A separate Azure resource may host the image deployment (mirrors Azure's
# usual key/endpoint split). Leave blank to disable the image tool.
AZURE_OPENAI_API_KEY_DALLE=
AZURE_OPENAI_ENDPOINT_DALLE=https://<your-dalle-resource>.openai.azure.com
AZURE_OPENAI_MODEL_DALLE=gpt-image-1

# --- Sora 2 video generation — optional -------------------------------------
# Comma-separated, index-aligned pools spread load across resources while each
# job (create/poll/download) stays pinned to the resource that served it.
# Point these DIRECTLY at each resource, NOT at a round-robin gateway.
# The n-th key belongs to the n-th endpoint; a single key/model is reused for
# every endpoint (only correct when the resources really share it).
AZURE_OPENAI_ENDPOINT_SORA=https://<sora-a>.openai.azure.com,https://<sora-b>.openai.azure.com
AZURE_OPENAI_API_KEY_SORA=<key-for-a>,<key-for-b>
AZURE_OPENAI_MODEL_SORA=sora-2
AZURE_OPENAI_API_VERSION_SORA=preview
# How many resources one clip may try before giving up (failover rotates to a
# resource that hasn't failed this clip). 0 = auto: pool size, capped at 3.
SORA_MAX_ATTEMPTS=0

# --- Token encryption -------------------------------------------------------
# Fernet key used to encrypt OAuth tokens at rest. If empty, AISMM generates
# one on first run and stores it in ./tokens.key (git-ignored). To pin it,
# generate with:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AISMM_TOKEN_KEY=

# --- Paths / runtime --------------------------------------------------------
AISMM_DATA_DIR=./data          # SQLite db + generated assets live here
ENV=dev
# Set to 0 to serve the dashboard WITHOUT the scheduler when running under a
# WSGI server (aismm.wsgi:application). Ignored by `aismm dashboard`/`scheduler`.
AISMM_ENABLE_SCHEDULER=1

# --- Dashboard --------------------------------------------------------------
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8787
# Public base URL the dashboard is reachable at. Required for OAuth redirect
# URIs and for Instagram (which fetches media from a PUBLIC url). For local
# testing use an https tunnel (e.g. ngrok) and put its URL here.
DASHBOARD_BASE_URL=http://127.0.0.1:8787
# Optional URL path where nginx/Caddy exposes AISMM (for example /aismm).
# This is automatically added to dashboard links, forms, assets, and OAuth URLs.
REVERSE_PROXY_PREFIX=
# Signs the session cookie that keeps you logged in. Set a long random value in
# production (a weak one lets an attacker forge a signed-in session):
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
FLASK_SECRET_KEY=change-me

# --- Dashboard sign-in (SSO / OpenID Connect) -------------------------------
# The dashboard has NO login of its own. Leave these blank only when it is bound
# to localhost; anything reachable from the internet must set them.
# Works with any OIDC provider — the endpoints come from the issuer's discovery
# document. Issuer examples:
#   Google      https://accounts.google.com
#   Entra ID    https://login.microsoftonline.com/<tenant-id>/v2.0
#   Okta        https://<org>.okta.com
# Register this redirect URI with the provider:
#   <DASHBOARD_BASE_URL><REVERSE_PROXY_PREFIX>/auth/callback
AUTH_OIDC_ISSUER=
AUTH_OIDC_CLIENT_ID=
AUTH_OIDC_CLIENT_SECRET=
AUTH_OIDC_SCOPES=openid,email,profile
# WHO may sign in. Authenticating is not enough — an identity must match one of
# these or it is refused. Leave both empty and EVERY login is rejected (fail
# closed), because otherwise any account at the provider would get in.
AUTH_ALLOWED_EMAILS=you@example.com
AUTH_ALLOWED_DOMAINS=
# Cosmetic: the sign-in button reads "Sign in with <name>".
AUTH_PROVIDER_NAME=SSO
AUTH_SESSION_HOURS=12
# Blank = auto (on as soon as the three AUTH_OIDC_* values are set).
# AUTH_ENABLED=0 disables the guard — only ever for local development.
AUTH_ENABLED=

# =============================================================================
# Social platform developer-app credentials
# See README.md for step-by-step "create an app + connect an account" guides.
# Each platform's redirect/callback URL is:
# <DASHBOARD_BASE_URL><REVERSE_PROXY_PREFIX>/oauth/<platform>/callback
# =============================================================================

# --- Instagram (Meta) — Instagram Graph API ---------------------------------
# Requires an Instagram Business/Creator account linked to a Facebook Page.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# --- X / Twitter — API v2 (OAuth 2.0 PKCE) ----------------------------------
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
# App-only / OAuth 1.0a keys are additionally needed for v1.1 media upload:
TWITTER_API_KEY=
TWITTER_API_SECRET=

# --- YouTube — Google Cloud OAuth (Data API v3) -----------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- TikTok — Content Posting API -------------------------------------------
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# --- Optional: LangSmith tracing --------------------------------------------
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_ENDPOINT=
# LANGCHAIN_API_KEY=
# LANGCHAIN_PROJECT=AISMM
